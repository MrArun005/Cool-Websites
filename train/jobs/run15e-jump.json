{
  "name": "bolt-run15e-jump",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_jump.py", "--name", "jump15e", "--steps", "10000000", "--lr", "1e-4", "--target-kl", "0.02",
              "--resume", "runs/jump15c/checkpoints/policy_6500000_steps.zip"],
      "resume_cmd": ["python", "-u", "train_jump.py", "--name", "jump15e", "--steps", "10000000", "--lr", "1e-4", "--target-kl", "0.02",
                     "--resume", "{latest}"],
      "latest": "runs/jump15e/checkpoints/policy_*_steps.zip",
      "log": "runs/jump15e/train.log",
      "done_when": {"exit_code": 0, "file": "runs/jump15e/policy.zip", "log_contains": "^done:"}
    }
  ]
}
