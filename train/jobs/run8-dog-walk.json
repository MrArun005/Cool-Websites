{
  "name": "bolt-run8-dog-walk",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train.py", "--name", "bolt8", "--steps", "6000000", "--envs", "8",
              "--skills", "walk", "--gait-generator", "dog"],
      "resume_cmd": ["python", "-u", "train.py", "--name", "bolt8", "--steps", "6000000", "--envs", "8",
                     "--skills", "walk", "--gait-generator", "dog", "--resume", "{latest}"],
      "latest": "runs/bolt8/checkpoints/policy_*_steps.zip",
      "log": "runs/bolt8/train.log",
      "done_when": {"exit_code": 0, "file": "runs/bolt8/policy.zip", "log_contains": "^done:"}
    },
    {
      "name": "watch",
      "cmd": ["python", "-u", "watch.py", "runs/bolt8", "--log", "runs/bolt8/train.log", "--out", "runs/bolt8/watch",
              "--target", "6000000", "--patience", "0", "--skills", "walk", "--gait-generator", "dog",
              "--label", "Run 8: dog gait (paw paths, lower legs near upright)"],
      "log": "runs/bolt8/watch.log",
      "done_when": {"log_contains": "^finished"}
    }
  ]
}
