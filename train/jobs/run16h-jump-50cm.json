{
  "name": "bolt-run16h-jump-50cm",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_jump.py", "--name", "jump16h", "--steps", "35000000", "--lr", "1e-4", "--target-kl", "0.02",
              "--n-steps", "2048", "--real", "--bar-start", "0.40", "--exam-heights", "0.30", "0.40", "0.50", "0.60", "--resume", "runs/jump16h_start/policy_27000000_steps.zip"],
      "resume_cmd": ["python", "-u", "train_jump.py", "--name", "jump16h", "--steps", "35000000", "--lr", "1e-4", "--target-kl", "0.02",
                     "--n-steps", "2048", "--real", "--bar-start", "0.40", "--exam-heights", "0.30", "0.40", "0.50", "0.60", "--resume", "{latest}"],
      "latest": "runs/jump16h/checkpoints/policy_*_steps.zip",
      "log": "runs/jump16h/train.log",
      "done_when": {"exit_code": 0, "file": "runs/jump16h/policy.zip", "log_contains": "^done:"}
    }
  ]
}
