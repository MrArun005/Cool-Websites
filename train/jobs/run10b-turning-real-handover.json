{
  "name": "bolt-run10b-turning-real-handover",
  "workdir": "..",
  "env": {
    "MUJOCO_GL": "osmesa"
  },
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": [
        "python",
        "-u",
        "train.py",
        "--name",
        "bolt10b",
        "--steps",
        "8000000",
        "--envs",
        "8",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--turning",
        "--handover-brain",
        "../models/bolt-dog-posture-dog-2.5M",
        "--resume",
        "runs/bolt10/checkpoints/policy_6000000_steps.zip"
      ],
      "resume_cmd": [
        "python",
        "-u",
        "train.py",
        "--name",
        "bolt10b",
        "--steps",
        "8000000",
        "--envs",
        "8",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--turning",
        "--handover-brain",
        "../models/bolt-dog-posture-dog-2.5M",
        "--resume",
        "{latest}"
      ],
      "latest": "runs/bolt10b/checkpoints/policy_*_steps.zip",
      "log": "runs/bolt10b/train.log",
      "done_when": {
        "exit_code": 0,
        "file": "runs/bolt10b/policy.zip",
        "log_contains": "^done:"
      }
    },
    {
      "name": "watch",
      "cmd": [
        "python",
        "-u",
        "watch.py",
        "runs/bolt10b",
        "--log",
        "runs/bolt10b/train.log",
        "--out",
        "runs/bolt10b/watch",
        "--target",
        "8000000",
        "--patience",
        "0",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--handover-brain",
        "../models/bolt-dog-posture-dog-2.5M",
        "--label",
        "Run 10b: turning walk, practising hand-overs from the real standing brain"
      ],
      "log": "runs/bolt10b/watch.log",
      "done_when": {
        "log_contains": "^finished"
      }
    }
  ]
}