{
  "name": "bolt-run16i-jump-runup",
  "workdir": "..",
  "env": {
    "MUJOCO_GL": "osmesa"
  },
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": [
        "python",
        "-u",
        "train_jump.py",
        "--name",
        "jump16i",
        "--steps",
        "45000000",
        "--lr",
        "1e-4",
        "--target-kl",
        "0.02",
        "--n-steps",
        "2048",
        "--real",
        "--bar-start",
        "0.40",
        "--approach",
        "0.5",
        "1.5",
        "--max-steps",
        "200",
        "--approach-speed",
        "3.0",
        "--exam-speed",
        "2.0",
        "--exam-dist",
        "1.5",
        "--exam-heights",
        "0.40",
        "0.50",
        "0.60",
        "0.70",
        "--resume",
        "runs/jump16i_start/policy_27500000_steps.zip"
      ],
      "resume_cmd": [
        "python",
        "-u",
        "train_jump.py",
        "--name",
        "jump16i",
        "--steps",
        "45000000",
        "--lr",
        "1e-4",
        "--target-kl",
        "0.02",
        "--n-steps",
        "2048",
        "--real",
        "--bar-start",
        "0.40",
        "--approach",
        "0.5",
        "1.5",
        "--max-steps",
        "200",
        "--approach-speed",
        "3.0",
        "--exam-speed",
        "2.0",
        "--exam-dist",
        "1.5",
        "--exam-heights",
        "0.40",
        "0.50",
        "0.60",
        "0.70",
        "--resume",
        "{latest}"
      ],
      "latest": "runs/jump16i/checkpoints/policy_*_steps.zip",
      "log": "runs/jump16i/train.log",
      "done_when": {
        "exit_code": 0,
        "file": "runs/jump16i/policy.zip",
        "log_contains": "^done:"
      }
    }
  ]
}