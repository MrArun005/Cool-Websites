{
  "name": "bolt-run21-turning",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa", "OMP_NUM_THREADS": "1"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_run.py", "--name", "run21", "--steps", "30000000", "--every", "1000000",
              "--turn-weight", "1.5", "--turn-focus", "0.4", "--resume", "runs/run21_start/policy_9000000_steps.zip"],
      "resume_cmd": ["python", "-u", "train_run.py", "--name", "run21", "--steps", "30000000", "--every", "1000000",
                     "--turn-weight", "1.5", "--turn-focus", "0.4", "--resume", "{latest}"],
      "latest": "runs/run21/checkpoints/policy_*_steps.zip",
      "log": "runs/run21/train.log",
      "done_when": {"exit_code": 0, "file": "runs/run21/policy.zip", "log_contains": "^done:"}
    }
  ]
}
