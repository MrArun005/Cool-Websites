{
  "name": "bolt-run15f-jump",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_jump.py", "--name", "jump15f", "--steps", "12000000", "--lr", "1e-4", "--target-kl", "0.02", "--n-steps", "2048",
              "--resume", "runs/jump15c/checkpoints/policy_8000000_steps.zip"],
      "resume_cmd": ["python", "-u", "train_jump.py", "--name", "jump15f", "--steps", "12000000", "--lr", "1e-4", "--target-kl", "0.02", "--n-steps", "2048",
                     "--resume", "{latest}"],
      "latest": "runs/jump15f/checkpoints/policy_*_steps.zip",
      "log": "runs/jump15f/train.log",
      "done_when": {"exit_code": 0, "file": "runs/jump15f/policy.zip", "log_contains": "^done:"}
    }
  ]
}
