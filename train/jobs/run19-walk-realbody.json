{
  "name": "bolt-run19-walk-realbody",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train.py", "--name", "bolt19", "--steps", "15000000", "--envs", "8", "--skills", "walk",
              "--gait-generator", "dog", "--turning", "--speed-control", "--sharp-turns",
              "--handover-brain", "../models/bolt-dog-posture-getup-3M", "--resume", "../models/bolt-dog-walk-sharp-12M/policy.zip"],
      "resume_cmd": ["python", "-u", "train.py", "--name", "bolt19", "--steps", "15000000", "--envs", "8", "--skills", "walk",
                     "--gait-generator", "dog", "--turning", "--speed-control", "--sharp-turns",
                     "--handover-brain", "../models/bolt-dog-posture-getup-3M", "--resume", "{latest}"],
      "latest": "runs/bolt19/checkpoints/policy_*_steps.zip",
      "log": "runs/bolt19/train.log",
      "done_when": {"exit_code": 0, "file": "runs/bolt19/policy.zip", "log_contains": "^done:"}
    }
  ]
}
