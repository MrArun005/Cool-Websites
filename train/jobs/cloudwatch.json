{
  "name": "bolt-cloudwatch",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 60,
  "jobs": [
    {
      "name": "watch",
      "cmd": ["python", "-u", "cloudwatch.py", "--out", "/tmp/claude-0/-home-user-Cool-Websites/029cd38f-3b1a-5876-9645-932075813c4a/scratchpad/learn/site/data/cloud.json", "--news", "/tmp/claude-0/-home-user-Cool-Websites/029cd38f-3b1a-5876-9645-932075813c4a/scratchpad/learn/site/data/news.json"],
      "log": "runs/cloudwatch.log",
      "done_when": {"exit_code": 0, "log_contains": "^finished"}
    }
  ]
}
