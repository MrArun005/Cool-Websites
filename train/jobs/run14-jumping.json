{
  "name": "bolt-run14-jumping",
  "workdir": "..",
  "env": {
    "MUJOCO_GL": "osmesa"
  },
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": [
        "python",
        "-u",
        "train.py",
        "--name",
        "bolt14",
        "--steps",
        "15000000",
        "--envs",
        "8",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--turning",
        "--speed-control",
        "--jumping",
        "--handover-brain",
        "../models/bolt-dog-posture-getup-3M",
        "--resume",
        "runs/jump_start/policy.zip"
      ],
      "resume_cmd": [
        "python",
        "-u",
        "train.py",
        "--name",
        "bolt14",
        "--steps",
        "15000000",
        "--envs",
        "8",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--turning",
        "--speed-control",
        "--jumping",
        "--handover-brain",
        "../models/bolt-dog-posture-getup-3M",
        "--resume",
        "{latest}"
      ],
      "latest": "runs/bolt14/checkpoints/policy_*_steps.zip",
      "log": "runs/bolt14/train.log",
      "done_when": {
        "exit_code": 0,
        "file": "runs/bolt14/policy.zip",
        "log_contains": "^done:"
      }
    },
    {
      "name": "watch",
      "cmd": [
        "python",
        "-u",
        "watch.py",
        "runs/bolt14",
        "--log",
        "runs/bolt14/train.log",
        "--out",
        "runs/bolt14/watch",
        "--target",
        "15000000",
        "--patience",
        "0",
        "--skills",
        "walk",
        "--gait-generator",
        "dog",
        "--handover-brain",
        "../models/bolt-dog-posture-getup-3M",
        "--label",
        "Run 14: jump hurdles (bounding jump, up to 20 cm)"
      ],
      "log": "runs/bolt14/watch.log",
      "done_when": {
        "log_contains": "^finished"
      }
    }
  ]
}