{
  "name": "bolt-run20b-run-fast",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa", "OMP_NUM_THREADS": "1"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_run.py", "--name", "run20b", "--steps", "60000000", "--every", "1000000"],
      "resume_cmd": ["python", "-u", "train_run.py", "--name", "run20b", "--steps", "60000000", "--every", "1000000", "--resume", "{latest}"],
      "latest": "runs/run20b/checkpoints/policy_*_steps.zip",
      "log": "runs/run20b/train.log",
      "done_when": {"exit_code": 0, "file": "runs/run20b/policy.zip", "log_contains": "^done:"}
    }
  ]
}
