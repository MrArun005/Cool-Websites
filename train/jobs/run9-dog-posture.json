{
  "name": "bolt-run9-dog-posture",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train.py", "--name", "bolt9", "--steps", "3000000", "--envs", "8",
              "--skills", "stand", "sit", "lie", "--gait-generator", "dog"],
      "resume_cmd": ["python", "-u", "train.py", "--name", "bolt9", "--steps", "3000000", "--envs", "8",
                     "--skills", "stand", "sit", "lie", "--gait-generator", "dog", "--resume", "{latest}"],
      "latest": "runs/bolt9/checkpoints/policy_*_steps.zip",
      "log": "runs/bolt9/train.log",
      "done_when": {"exit_code": 0, "file": "runs/bolt9/policy.zip", "log_contains": "^done:"}
    },
    {
      "name": "watch",
      "cmd": ["python", "-u", "watch.py", "runs/bolt9", "--log", "runs/bolt9/train.log", "--out", "runs/bolt9/watch",
              "--target", "3000000", "--patience", "0", "--skills", "stand", "sit", "lie", "--gait-generator", "dog",
              "--label", "Run 9: stand, sit, lie, standing in the dog stance"],
      "log": "runs/bolt9/watch.log",
      "done_when": {"log_contains": "^finished"}
    }
  ]
}
