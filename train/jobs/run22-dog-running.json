{
  "name": "bolt-run22-dog-running",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa", "OMP_NUM_THREADS": "1"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_run.py", "--name", "run22", "--steps", "30000000", "--every", "500000",
              "--turn-weight", "1.5", "--turn-focus", "0.3", "--style-weight", "1.5", "--resume", "runs/run22_start/policy_9000000_steps.zip"],
      "resume_cmd": ["python", "-u", "train_run.py", "--name", "run22", "--steps", "30000000", "--every", "500000",
                     "--turn-weight", "1.5", "--turn-focus", "0.3", "--style-weight", "1.5", "--resume", "{latest}"],
      "latest": "runs/run22/checkpoints/policy_*_steps.zip",
      "log": "runs/run22/train.log",
      "done_when": {"exit_code": 0, "file": "runs/run22/policy.zip", "log_contains": "^done:"}
    }
  ]
}
