{
  "name": "bolt-run16c-real-hurdle",
  "workdir": "..",
  "env": {"MUJOCO_GL": "osmesa"},
  "check_every": 30,
  "jobs": [
    {
      "name": "train",
      "cmd": ["python", "-u", "train_jump.py", "--name", "jump16c", "--steps", "14000000", "--lr", "1e-4", "--target-kl", "0.02",
              "--n-steps", "2048", "--real", "--widen-from", "../models/bolt-dog-jump-10M", "--bar-start", "0.18"],
      "resume_cmd": ["python", "-u", "train_jump.py", "--name", "jump16c", "--steps", "14000000", "--lr", "1e-4", "--target-kl", "0.02",
                     "--n-steps", "2048", "--real", "--bar-start", "0.18", "--resume", "{latest}"],
      "latest": "runs/jump16c/checkpoints/policy_*_steps.zip",
      "log": "runs/jump16c/train.log",
      "done_when": {"exit_code": 0, "file": "runs/jump16c/policy.zip", "log_contains": "^done:"}
    }
  ]
}
