{
  "name": "self-improving-coder",
  "version": "0.1.0",
  "description": "A JS coding agent that learns lessons, skills and prompts from unit-test feedback, gated by a holdout set.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "fetch": "node src/dataset/fetch.js",
    "start": "node src/run.js",
    "dry-run": "node src/run.js --dry-run",
    "chart": "node src/chart.js",
    "reproduce": "node src/reproduce.js",
    "report": "node src/report.js",
    "site": "node site/build.js",
    "generate": "node src/mutate/generate.js",
    "power": "node src/power.js"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "hyparquet": "1.33.1"
  },
  "optionalDependencies": {
    "@ax-llm/ax": "25.4.13"
  }
}
