{
  "llm": {
    "provider": "openai-compatible",
    "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
    "apiKeyEnv": "SIC_LLM_API_KEY",
    "model": "qwen2.5-coder:0.5b",
    "temperature": 0.4,
    "evalTemperature": 0,
    "seed": 1234,
    "maxTokens": 512,
    "requestTimeoutMs": 180000,
    "retry": {
      "maxAttempts": 4,
      "baseDelayMs": 2000,
      "maxDelayMs": 30000,
      "retryOnStatus": [
        408,
        409,
        425,
        429,
        500,
        502,
        503,
        504
      ]
    },
    "mock": {
      "mode": "scripted",
      "scriptPath": "test/fixtures/problems.json",
      "charsPerToken": 4,
      "seed": 7,
      "synthetic": {
        "defaultBase": 0.35,
        "lessonBoost": 0.35,
        "skillBoost": 0.1,
        "promptBoost": 0.05,
        "maxPass": 0.95,
        "usefulLessonRate": 0.55,
        "promptBoostPhrase": "Check edge cases",
        "vagueLessons": [
          "Read the problem statement carefully.",
          "Test your code mentally before answering.",
          "Handle edge cases."
        ],
        "families": {
          "range": {
            "base": 0.3,
            "fixPhrase": "include both ends",
            "lesson": "For ranges described as 'from a to b', include both ends of the range (use <=, not <).",
            "tags": [
              "range",
              "inclusive",
              "off-by-one"
            ]
          },
          "extreme": {
            "base": 0.35,
            "fixPhrase": "from the first element",
            "lesson": "Start a running maximum or minimum from the first element, not from 0.",
            "tags": [
              "maximum",
              "minimum",
              "initialisation"
            ]
          },
          "empty": {
            "base": 0.3,
            "fixPhrase": "empty list first",
            "lesson": "Check for an empty list first and return the stated default.",
            "tags": [
              "empty",
              "list",
              "default"
            ]
          },
          "case": {
            "base": 0.4,
            "fixPhrase": "lower-case both",
            "lesson": "When case should be ignored, lower-case both sides before comparing.",
            "tags": [
              "case",
              "string",
              "compare"
            ]
          },
          "round": {
            "base": 0.35,
            "fixPhrase": "Math.round",
            "lesson": "To round to the nearest value use Math.round, not Math.floor.",
            "tags": [
              "round",
              "rounding",
              "math"
            ]
          },
          "easy": {
            "base": 0.85
          },
          "flip-comparison": {
            "base": 0.3,
            "fixPhrase": "comparison operators",
            "lesson": "Check each comparison operator (<, <=, ===) against the failing expected values.",
            "tags": [
              "comparison",
              "operator",
              "boundary"
            ]
          },
          "off-by-one": {
            "base": 0.3,
            "fixPhrase": "off by one",
            "lesson": "Look for numeric constants or indexes that are off by one.",
            "tags": [
              "index",
              "off-by-one",
              "constant"
            ]
          },
          "drop-branch": {
            "base": 0.2,
            "fixPhrase": "missing branch",
            "lesson": "If a case is silently ignored, look for a missing branch or empty if-block.",
            "tags": [
              "branch",
              "condition",
              "missing"
            ]
          },
          "swap-arguments": {
            "base": 0.3,
            "fixPhrase": "argument order",
            "lesson": "Check the argument order of every call against the callee's signature.",
            "tags": [
              "arguments",
              "order",
              "call"
            ]
          },
          "wrong-return": {
            "base": 0.35,
            "fixPhrase": "returned value",
            "lesson": "Check that each return statement returns the computed value, not a negation or undefined.",
            "tags": [
              "return",
              "value"
            ]
          },
          "flip-logical": {
            "base": 0.3,
            "fixPhrase": "&& and ||",
            "lesson": "Check whether && and || are swapped in conditions.",
            "tags": [
              "logical",
              "condition",
              "boolean"
            ]
          }
        }
      },
      "evolveAnswer": "Check edge cases (empty input, boundaries, negative numbers) before answering."
    },
    "errorSnippetChars": 300
  },
  "runtime": {
    "ollamaVersion": "0.40.16",
    "ollamaDownloadUrl": "https://github.com/ollama/ollama/releases/download/v{version}/ollama-linux-amd64.tar.zst",
    "ollamaHost": "127.0.0.1:11434",
    "ollamaReadyTimeoutSec": 60,
    "artifactName": "sic-state",
    "artifactRetentionDays": 7,
    "publishArtifactName": "sic-publish"
  },
  "budget": {
    "totalRequestsPerRun": 2940,
    "totalRequestsPerDay": 3360,
    "holdoutFraction": 0.72,
    "maxRunMinutes": 100,
    "reserveMinutesForHoldout": 40
  },
  "dataset": {
    "revision": "28441b6024e71d4a1c1c0f6bf171c935cd5a43f2",
    "source": {
      "humaneval-js": "https://huggingface.co/datasets/nuprl/MultiPL-E/resolve/{revision}/humaneval-js/test-00000-of-00001.parquet",
      "mbpp-js": "https://huggingface.co/datasets/nuprl/MultiPL-E/resolve/{revision}/mbpp-js/test-00000-of-00001.parquet"
    },
    "cacheDir": "data",
    "problemsFile": "problems.json",
    "fetchTimeoutMs": 60000,
    "fixturePath": "test/fixtures/problems.json"
  },
  "split": {
    "seed": 20261119,
    "holdoutSize": 50
  },
  "agent": {
    "maxAttemptsPerProblem": 2,
    "lessonsTopK": 3,
    "skillsTopK": 2,
    "maxLessons": 60,
    "maxSkillChars": 1200,
    "maxLessonWords": 40,
    "maxLessonTags": 6,
    "reflectOutputChars": 800,
    "retryFailedAfterRuns": 1
  },
  "retrieve": {
    "minTokenLength": 3,
    "minScore": 0.05,
    "stopwords": [
      "the",
      "and",
      "for",
      "that",
      "this",
      "with",
      "are",
      "given",
      "function",
      "return",
      "returns",
      "write",
      "from",
      "into",
      "which",
      "will",
      "should",
      "you",
      "your",
      "list",
      "number",
      "numbers",
      "array",
      "string",
      "input",
      "output",
      "example",
      "examples",
      "let",
      "const",
      "candidate",
      "true",
      "false",
      "null",
      "undefined",
      "each",
      "all",
      "its",
      "than",
      "then",
      "have",
      "has",
      "not",
      "but",
      "can",
      "only",
      "one",
      "two",
      "use",
      "using",
      "case",
      "value",
      "values",
      "element",
      "elements",
      "given",
      "find",
      "check",
      "whether"
    ]
  },
  "judge": {
    "timeoutMs": 6000,
    "maxOutputBytes": 16384,
    "maxMemoryMb": 256,
    "useNodePermissionModel": true,
    "tmpRoot": "",
    "failPatterns": [
      "AssertionError",
      "^not ok \\d+"
    ],
    "dropOutputLinePatterns": [
      "^\\s+at .*\\(?node:internal/",
      "^\\s+at (Module|Function|Object)\\.[\\w.<>]+ \\(node:",
      "^node:(assert|internal)[\\w/.:]*$",
      "^\\s+throw new AssertionError\\(obj\\);$",
      "^\\s+\\^$",
      "^Node\\.js v\\d+"
    ]
  },
  "gate": {
    "minImprovement": 0.025,
    "tolerance": 0.025,
    "baselineRuns": 2,
    "maxPendingRuns": 3,
    "method": "ci"
  },
  "paths": {
    "stateDir": "state",
    "champion": "champion.json",
    "lessons": "lessons.json",
    "skillsDir": "skills",
    "promptsDir": "prompts",
    "split": "split.json",
    "scores": "scores.csv",
    "attempts": "problem-status.json",
    "runState": "run-state.json",
    "budget": "budget.json",
    "lastRun": "last-run.json",
    "templatesDir": "prompts",
    "solveUserTemplate": "solve-user.md",
    "reflectSystemTemplate": "reflect-system.md",
    "reflectUserTemplate": "reflect-user.md",
    "seedPrompt": "prompts/system-v001.md",
    "variantsDir": "variants",
    "attemptsLog": "attempts.jsonl",
    "traces": "traces.jsonl",
    "evals": "evals.jsonl",
    "gateLog": "gate-log.jsonl",
    "chartsDir": ".",
    "reportFile": "REPORT.md",
    "readme": "README.md"
  },
  "chart": {
