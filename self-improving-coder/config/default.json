    },
    "features": {
      "promptOptimizer": false
    },
    "curriculum": {
      "useFixtureRepo": true
    }
  },
  "taxonomy": {
    "passClass": "pass",
    "classes": [
      "syntax",
      "runtime-error",
      "timeout",
      "wrong-output",
      "spec-misread",
      "other"
    ],
    "rules": [
      {
        "class": "timeout",
        "resultTypes": [
          "timeout"
        ]
      },
      {
        "class": "syntax",
        "resultTypes": [
          "error",
          "fail"
        ],
        "outputPatterns": [
          "SyntaxError"
        ]
      },
      {
        "class": "spec-misread",
        "resultTypes": [
          "error",
          "fail"
        ],
        "outputPatterns": [
          "ReferenceError: {{entryPoint}} is not defined",
          "candidate is not a function",
          "\\b{{entryPoint}} is not a function"
        ]
      },
      {
        "class": "spec-misread",
        "resultTypes": [
          "error",
          "fail"
        ],
        "checks": [
          "entryPointMissing",
          "arityMismatch"
        ]
      },
      {
        "class": "runtime-error",
        "resultTypes": [
          "error",
          "fail"
        ],
        "outputPatterns": [
          "operator: error",
          "^\\s*(Uncaught )?(TypeError|RangeError|ReferenceError|EvalError|URIError|InternalError)\\b",
          "^\\w*Error: ",
          "Maximum call stack"
        ]
      },
      {
        "class": "wrong-output",
        "resultTypes": [
          "fail"
        ],
        "outputPatterns": [
          "AssertionError",
          "^not ok \\d+"
        ]
      },
      {
        "class": "other"
      }
    ],
    "description": {
      "syntax": "the code does not parse",
      "runtime-error": "the code throws (TypeError, RangeError, stack overflow, ...)",
      "timeout": "the tests did not finish in time (usually an infinite loop)",
      "wrong-output": "the code runs but a test assertion fails",
      "spec-misread": "wrong function name or signature, or the function is missing",
      "other": "non-zero exit with no recognisable error (e.g. process.exit, out of memory)"
    }
  },
